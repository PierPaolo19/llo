# LLO - Educational Blockchain Testing Configuration
# ⚠️ FOR TESTNET USE ONLY - NEVER USE REAL KEYS OR MAINNET

# Example configuration for learning purposes
# Copy this file to .env and configure with YOUR TESTNET details

# IMPORTANT: NEVER commit your .env file with real keys!
# IMPORTANT: Only use test wallets created specifically for learning
# IMPORTANT: Never use keys that have been used on mainnet

# Selected testnet (choose one)
# Options: ethereum_sepolia, ethereum_goerli, bsc_testnet, polygon_mumbai, tron_shasta
TESTNET=ethereum_sepolia

# Test wallet address (public address is safe to share)
# Example: 0x1234567890123456789012345678901234567890
TEST_WALLET_ADDRESS=

# ⚠️ NEVER put a real private key here! Create a new test-only wallet!
# This should be a private key for a wallet that:
# - Was created specifically for testing
# - Has never been used on mainnet
# - Will never hold real cryptocurrency
# TEST_PRIVATE_KEY=

# Optional: RPC endpoint API keys for better rate limits
# Get free keys from:
# - Infura: https://infura.io/
# - Alchemy: https://www.alchemy.com/
# INFURA_API_KEY=
# ALCHEMY_API_KEY=

# Educational mode (always true)
EDUCATIONAL_MODE=true

# Confirm you understand this is testnet only
TESTNET_ONLY=true
