# Example environment variables for Flash USDT Script
# Copy this file to .env and fill in your values

# WARNING: NEVER commit your actual .env file with real private keys!

# Ethereum Private Key (without 0x prefix)
ETH_PRIVATE_KEY=your_ethereum_private_key_here

# BSC Private Key (without 0x prefix)
BSC_PRIVATE_KEY=your_bsc_private_key_here

# TRON Private Key (without 0x prefix)
TRON_PRIVATE_KEY=your_tron_private_key_here

# Optional: Custom RPC URLs
# ETH_RPC_URL=https://eth.llamarpc.com
# BSC_RPC_URL=https://bsc-dataseed.binance.org
