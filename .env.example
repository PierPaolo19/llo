# ==============================================================================
# PRIVATE KEYS (NEVER commit this file with real keys!)
# ==============================================================================
PRIVATE_KEY=your_private_key_here

# ==============================================================================
# RPC PROVIDER API KEYS
# ==============================================================================

# Alchemy API Keys (Recommended)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Infura API Keys (Alternative)
INFURA_API_KEY=your_infura_api_key_here

# ==============================================================================
# ETHEREUM NETWORK RPC URLs (ERC20)
# ==============================================================================

# Using Alchemy (replace YOUR_ALCHEMY_API_KEY with your actual key)
ETHEREUM_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
GOERLI_RPC_URL=https://eth-goerli.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Alternative: Using Infura (uncomment and replace YOUR_INFURA_API_KEY)
# ETHEREUM_MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_API_KEY
# GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_API_KEY
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_API_KEY

# ==============================================================================
# BINANCE SMART CHAIN RPC URLs (BEP20)
# ==============================================================================
BSC_MAINNET_RPC_URL=https://bsc-dataseed1.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Alternative BSC RPC endpoints
# BSC_MAINNET_RPC_URL=https://bsc-dataseed2.binance.org
# BSC_MAINNET_RPC_URL=https://bsc-dataseed3.binance.org

# ==============================================================================
# POLYGON NETWORK RPC URLs (ERC20 compatible)
# ==============================================================================

# Using Alchemy for Polygon (replace YOUR_ALCHEMY_API_KEY with your actual key)
POLYGON_MAINNET_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
POLYGON_MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Alternative: Public endpoints (may be rate-limited)
# POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com
# POLYGON_MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# ==============================================================================
# BLOCK EXPLORER API KEYS (For Contract Verification)
# ==============================================================================
ETHERSCAN_API_KEY=your_etherscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# ==============================================================================
# TRON NETWORK (TRC20) - Requires TronBox or TronWeb
# ==============================================================================
TRONGRID_API_KEY=your_trongrid_api_key

# TRON Mainnet
TRON_MAINNET_FULL_NODE=https://api.trongrid.io
TRON_MAINNET_SOLIDITY_NODE=https://api.trongrid.io
TRON_MAINNET_EVENT_SERVER=https://api.trongrid.io

# TRON Testnet (Shasta)
TRON_TESTNET_FULL_NODE=https://api.shasta.trongrid.io
TRON_TESTNET_SOLIDITY_NODE=https://api.shasta.trongrid.io
TRON_TESTNET_EVENT_SERVER=https://api.shasta.trongrid.io

# TRON Private Key (separate from EVM private key)
TRON_PRIVATE_KEY=your_tron_private_key_here

# ==============================================================================
# OPTIONAL: ADDITIONAL SERVICE API KEYS
# ==============================================================================

# CoinMarketCap API (for gas price oracle and price feeds)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Moralis API (for Web3 data and APIs)
MORALIS_API_KEY=your_moralis_api_key

# The Graph API (for querying blockchain data)
THEGRAPH_API_KEY=your_thegraph_api_key

# Tenderly API (for debugging and monitoring)
TENDERLY_ACCESS_KEY=your_tenderly_access_key
TENDERLY_PROJECT_SLUG=your_project_slug

# Defender API (OpenZeppelin Defender for automation)
DEFENDER_API_KEY=your_defender_api_key
DEFENDER_API_SECRET=your_defender_api_secret

# ==============================================================================
# GAS PRICE SETTINGS (Optional)
# ==============================================================================
# GAS_PRICE_API=https://api.etherscan.io/api?module=gastracker&action=gasoracle&apikey=${ETHERSCAN_API_KEY}
