# Flash USDT Environment Configuration
# Copy this file to .env and fill in your values

# IMPORTANT: Never commit your actual .env file to Git!

# ===========================================
# Private Key (without 0x prefix)
# ===========================================
# Get this from MetaMask: Settings > Security & Privacy > Show private key
# NEVER share your private key!
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# ===========================================
# RPC URLs (Optional - defaults provided)
# ===========================================

# Ethereum Mainnet
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# Ethereum Sepolia Testnet
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Binance Smart Chain Mainnet
BSC_RPC_URL=https://bsc-dataseed.binance.org

# BSC Testnet
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Polygon Mainnet
POLYGON_RPC_URL=https://polygon-rpc.com

# Polygon Mumbai Testnet
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# ===========================================
# API Keys for Block Explorers (Optional)
# ===========================================
# Used for contract verification

# Etherscan (for Ethereum networks)
ETHERSCAN_API_KEY=your_etherscan_api_key

# BscScan (for BSC networks)
BSCSCAN_API_KEY=your_bscscan_api_key

# PolygonScan (for Polygon networks)
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# ===========================================
# Notes
# ===========================================
# 
# Getting API Keys:
# - Etherscan: https://etherscan.io/myapikey
# - BscScan: https://bscscan.com/myapikey
# - PolygonScan: https://polygonscan.com/myapikey
#
# Getting Test Tokens:
# - Sepolia ETH: https://sepoliafaucet.com
# - BSC Testnet BNB: https://testnet.binance.org/faucet-smart
# - Mumbai MATIC: https://faucet.polygon.technology
#
# Security:
# - This .env file is in .gitignore - DO NOT remove it from there
# - Never share your private key or push it to GitHub
# - Use separate wallets for development and production
# - Consider using hardware wallets for mainnet deployments
